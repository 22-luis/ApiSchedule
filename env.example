# Configuración de la aplicación
ENVIRONMENT=development
DEBUG=true
APP_NAME=ApiSchedule
APP_VERSION=1.0.0

# Configuración de seguridad
SECRET_KEY=your-super-secret-key-with-at-least-32-characters-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Configuración de base de datos PostgreSQL
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=apischedule_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=prefer

# Configuración de CORS (separados por comas)
CORS_ORIGINS_STR=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS_STR=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOW_HEADERS_STR=*

# Configuración de logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Configuración de rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60


# Configuración de SQLAlchemy
SQLALCHEMY_ECHO=false
SQLALCHEMY_LOG_LEVEL=WARNING

# Configuración de zona horaria
DEFAULT_TIMEZONE=America/El_Salvador

# Configuración de horarios de trabajo
WORKING_HOURS_MONDAY_FRIDAY=07:00-16:00
WORKING_HOURS_SATURDAY=07:30-11:30
WORKING_HOURS_SUNDAY=00:00-00:00
